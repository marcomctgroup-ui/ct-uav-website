  "settle_ms": 1600,
  "state_wait_ms": 900,
  "ignore_selectors": [
    ".review-bar"
  ],
  "approved_dark_exceptions": [
    ".bar-contact:hover",
    ".applications-actions .payload-open:hover",
    ".payload-contact:hover",
    ".site-footer__social a"
