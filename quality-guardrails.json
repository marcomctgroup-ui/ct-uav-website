    "warn_below_normal": 4.5,
    "warn_below_large": 3.0,
    "large_px": 24,
    "large_bold_px": 18.6
  },
  "dark": {
    "luminance_below": 0.2,
    "min_alpha": 0.35,
    "min_area_px2": 600
  },
