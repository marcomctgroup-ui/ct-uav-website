{
  "_about": "Measured limits for the main website demo. Rules and reasons: QUALITY-GUARDRAILS.md. Change a limit only when Haykal approves it, and record the change in that file.",
  "version": "v02",
  "date": "2026-10-22",
  "widths": [
    1440,
    768,
    390
  ],
  "full_widths": [
    1440,
    1024,
    768,
    390,
    320
  ],
  "phone_max_width": 480,
